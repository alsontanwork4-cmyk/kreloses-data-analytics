# Copy to .env.local (never commit it). `npm run db:create-dev -- kx_dev_<you> --env` fills in the
# first three for local development from `supabase status`.

# --- App database (server only) --------------------------------------------------------------
# Direct Postgres for all app data. Local: your own database on the local cluster, e.g.
#   postgresql://postgres:postgres@127.0.0.1:54322/kx_dev_<you>
# Production: the Supabase pooler URL (add ?sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Prepared statements. Default: false when DATABASE_URL uses port 6543 (Supabase's transaction
# pooler), true otherwise. Only set it to override.
# DATABASE_PREPARE=false
# Connections per server instance. Default: 3.
# DATABASE_POOL_MAX=3

# --- Supabase Auth (magic links only) ----------------------------------------------------------
# Local: http://127.0.0.1:54321 and the publishable key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Access --------------------------------------------------------------------------------------
# Always allowed in, as owner. Added to app_users automatically the first time the server checks
# access (and by `npm run db:create-dev`).
OWNER_EMAIL=owner@example.com

# --- Local tooling only (optional) ---------------------------------------------------------------
# Superuser URL of the local cluster, used by the test harness and db:* scripts.
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local mail catcher (Mailpit) that e2e tests read magic links from.
# E2E_MAILPIT_URL=http://127.0.0.1:54324
# Port for the e2e suite's own Next.js server. Default: derived from the worktree path.
# E2E_PORT=4102
