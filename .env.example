# Copy to .env.local (never commit it). `npm run db:create-dev -- kx_dev_<you> --env` fills in the
# first three for local development from `supabase status`.

# --- App database (server only) --------------------------------------------------------------
# Direct Postgres for all app data. Local: your own database on the local cluster, e.g.
#   postgresql://postgres:postgres@127.0.0.1:54322/kx_dev_<you>
# Production: the Supabase pooler URL (add ?sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Prepared statements. Default: false when DATABASE_URL uses port 6543 (Supabase's transaction
# pooler), true otherwise. Only set it to override.
# DATABASE_PREPARE=false
# Connections per server instance. Default: 3.
# DATABASE_POOL_MAX=3

# --- Supabase Auth (magic links only) ----------------------------------------------------------
# Local: http://127.0.0.1:54321 and the publishable key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Access --------------------------------------------------------------------------------------
# Always allowed in, as owner. Added to app_users automatically the first time the server checks
# access (and by `npm run db:create-dev`).
OWNER_EMAIL=owner@example.com

# --- Kreloses credentials (server only) ----------------------------------------------------------
# Encrypts Kreloses passwords at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Required to save or test a connection. `npm run db:create-dev -- <name> --env` generates a local
# one. Use a different key in production; changing it makes stored passwords unreadable.
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-base64_32

# --- MCP server for Claude (server only) -----------------------------------------------------------
# The bearer token Claude sends to /api/mcp. At least 32 characters:
#   openssl rand -base64 32
# Unset (or too short) = the MCP endpoint refuses every request. It grants read access to ALL clinic
# data: treat it like a password, and use a different one in production.
# MCP_BEARER_TOKEN=

# --- Sync (optional) -------------------------------------------------------------------------------
# Time budget of one sync invocation in seconds (10-280). Default 200: a run stops starting new
# Kreloses requests after this and records where it got to, well before the function's 300 s limit.
# SYNC_TIME_BUDGET_SECONDS=200

# --- Local tooling only (optional) ---------------------------------------------------------------
# Superuser URL of the local cluster, used by the test harness and db:* scripts.
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local mail catcher (Mailpit) that e2e tests read magic links from.
# E2E_MAILPIT_URL=http://127.0.0.1:54324
# Port for the e2e suite's own Next.js server. Default: derived from the worktree path.
# E2E_PORT=4102
# Port for the e2e suite's fake Kreloses. Default: E2E_PORT + 1000.
# E2E_KRELOSES_PORT=5102
# Tests only: point the Kreloses Reader at a local fake Kreloses (the e2e suite sets these itself).
# Refused when NODE_ENV=production, and only loopback URLs are accepted.
# KRELOSES_BASE_URL_WWW=http://127.0.0.1:5123
# KRELOSES_BASE_URL_SEA=http://127.0.0.1:5123
# Opt-in live smoke test against the REAL Kreloses (`npm run test:live`). Prefer exporting them in
# the shell for one run (see README "Live login check") over saving them here.
# KRELOSES_TEST_EMAIL=
# KRELOSES_TEST_PASSWORD=
# KRELOSES_TEST_SESSION_PROBE_MINUTES=0
